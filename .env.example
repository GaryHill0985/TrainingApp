# ---- App (safe to expose: shipped to the browser) ----
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---- Server-side only (NEVER shipped to the browser, used by scripts/) ----
# Supabase > Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Supabase > Project Settings > Database > Connection string (password you set when creating the project)
SUPABASE_DB_PASSWORD=your-database-password

# ---- The two real accounts behind the PIN screen (created by scripts/create-users.ts) ----
TRAINEE_EMAIL=lucas@example.com
TRAINEE_PASSWORD=choose-a-long-password
COACH_EMAIL=dad@example.com
COACH_PASSWORD=choose-a-long-password
